{
	"name": "dm-monorepo",
	"private": true,
	"version": "0.1.0",
	"packageManager": "npm@10.9.0",
	"workspaces": [
		"legacy-vite-app",
		"next-app"
	],
	"scripts": {
		"dev": "turbo run dev",
		"dev:legacy": "turbo run dev --filter=@dm/legacy-vite-app",
		"dev:next": "turbo run dev --filter=@dm/next-app",
		"build": "turbo run build",
		"lint": "turbo run lint",
		"clean": "turbo run clean"
	},
	"devDependencies": {
		"turbo": "^2.5.8"
	}
}
